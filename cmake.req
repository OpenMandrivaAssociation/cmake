if(OFF)
find_package(AlsoHidden)
endif()
]]
find_package(Shown)
if(OFF)
  find_package(Dead)
endif()
''', ['Shown'], ['Hidden', 'AlsoHidden', 'Dead'])

    check('''
if(ON)
  find_package(Foo 1.2.3 REQUIRED)
endif()
''', ['Foo'], [])
    got = cmake_requires_from_text('find_package(Foo 1.2.3 REQUIRED)\n')
    if got != ['(cmake(foo) >= 1.2.3 or cmake(Foo) >= 1.2.3)']:
        raise SystemExit('version: %s' % got)

    check('''
if(OFF)
  find_package(Bar)
if(ON)
  find_package(Foo)
endif()
''', ['Foo', 'Bar'], [])

